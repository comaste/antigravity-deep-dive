{
  "name": "antigravity-deep-dive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "pnpm -r build",
    "dev": "pnpm --parallel -r dev",
    "test": "vitest run",
