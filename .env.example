# サーバー設定
PORT=3001
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
GCP_PROJECT_ID=demo-notion-box-search
NOTION_REDIRECT_URI=http://localhost:3001/api/oauth/notion/callback
BOX_REDIRECT_URI=http://localhost:3001/api/oauth/box/callback

# API キー・OAuth クライアントシークレットは平文の .env に書かず、
# `just sync-secrets` または `just set-secret <KEY> <op://...>` で
# 1Password から macOS Keychain (service: dev.kexi.notion-box-search) に移して自動取得します。
# （Cloud Run 本番環境では Secret Manager から環境変数として注入されます）
# 対象キー: GEMINI_API_KEY, NOTION_CLIENT_ID, NOTION_CLIENT_SECRET, BOX_CLIENT_ID, BOX_CLIENT_SECRET
